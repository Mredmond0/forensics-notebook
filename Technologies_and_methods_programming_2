________Key&Mouse_______
!*python_file*!
from tkinter import *
def keyPass(k):
  print("keyPress->",k,keysym,k.keycode)
  if k.keysym == 'Escape': form1.quit()
def mouseMove(m):
  print("mouseMove->",m.x,m.y)
def mousePress(mouse):
  print("mousePress->", mouse.x, mouse.y)

form1 = Tk()
form1.bind("<KeyPress>", keyPress)
form1.bind("<B1-Motion>", mouseMove)  #B1 - левая кнопка, B2 - колесико, B3 - правая кнопка на мышке
form1.bind("<Button-1>", mousePress)  #левое нажатие мышки






