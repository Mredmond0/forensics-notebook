______Nomodal___________
!*python_file*!
from tkinter import *
def click1() :
  global fView
  def delForm() :
    global fView
    fView = False
    form.destroy()
  if not (fView):
    form = Toplevel(form1)
    form.protocol("WM_DELETE_WINDOW", delForm)
    form.focus_set()
    fView = True
form1 = Tk()
fView = False
Button(text= 'Norma', command = click1) .place(x=5, y=5)
form1.mainloop()
